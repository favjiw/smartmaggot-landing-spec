# --- Database PostgreSQL ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gardahijau
DATABASE_SSL=false

# --- Admin web ---
# Minimal 32 karakter acak. Wajib di produksi.
JWT_SECRET=ganti-dengan-random-secret-minimal-32-karakter
ADMIN_EMAIL=admin@gardahijau.com
ADMIN_PASSWORD=ganti-password-ini

# --- API aplikasi Garda Hijau (angka dampak di landing page) ---
# Dokumentasi: https://gardahijau.codelabspace.or.id/api-docs/
GARDAHIJAU_API_URL=https://gardahijau.codelabspace.or.id
# Akun layanan (username/password aplikasi Android) untuk membaca data pencacahan & siklus.
# Tidak diperlukan lagi setelah backend menyediakan GET /api/public/ringkasan.
GARDAHIJAU_API_USERNAME=
GARDAHIJAU_API_PASSWORD=
# Isi true untuk mematikan integrasi dan hanya memakai angka manual dari admin.
GARDAHIJAU_API_DISABLED=false
